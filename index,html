<script>
const cursor = document.getElementById('cursor');
const ring = document.getElementById('cursorRing');
let mx = 0, my = 0, rx = 0, ry = 0;

document.addEventListener('mousemove', e => {
  mx = e.clientX; my = e.clientY;
  cursor.style.left = mx + 'px';
  cursor.style.top = my + 'px';
});

function animRing() {
  rx += (mx - rx) * 0.12;
  ry += (my - ry) * 0.12;
  ring.style.left = rx + 'px';
  ring.style.top = ry + 'px';
  requestAnimationFrame(animRing);
}
animRing();

document.querySelectorAll('a, button, .service-card').forEach(el => {
  el.addEventListener('mouseenter', () => { cursor.style.width = '20px'; cursor.style.height = '20px'; ring.style.width = '54px'; ring.style.height = '54px'; });
  el.addEventListener('mouseleave', () => { cursor.style.width = '12px'; cursor.style.height = '12px'; ring.style.width = '36px'; ring.style.height = '36px'; });
});

const heroCanvas = document.getElementById('roofCanvas');
const hCtx = heroCanvas.getContext('2d');

function resizeHero() { heroCanvas.width = heroCanvas.offsetWidth; heroCanvas.height = heroCanvas.offsetHeight; }
resizeHero();
window.addEventListener('resize', resizeHero);

const roofShapes = [
  { x: 0.1, y: 0.95, w: 0.3, h: 0.6, peak: 0.4 },
  { x: 0.35, y: 0.95, w: 0.22, h: 0.5, peak: 0.55 },
  { x: 0.55, y: 0.95, w: 0.4, h: 0.65, peak: 0.35 },
  { x: 0.88, y: 0.95, w: 0.25, h: 0.45, peak: 0.65 },
];

const drops = Array.from({length: 140}, () => ({
  x: Math.random(), y: Math.random(),
  speed: 0.002 + Math.random() * 0.004,
  length: 0.02 + Math.random() * 0.04,
  opacity: 0.05 + Math.random() * 0.15,
}));

const particles = Array.from({length: 60}, () => ({
  x: Math.random(), y: Math.random(),
  vx: (Math.random() - 0.5) * 0.0008,
  vy: -0.0003 - Math.random() * 0.0006,
  r: 0.5 + Math.random() * 1.5,
  opacity: 0.1 + Math.random() * 0.3,
}));

let heroT = 0;

function drawHero() {
  const W = heroCanvas.width, H = heroCanvas.height;
  hCtx.clearRect(0, 0, W, H);
  const sky = hCtx.createLinearGradient(0, 0, 0, H);
  sky.addColorStop(0, '#0a0e1a'); sky.addColorStop(0.5, '#1a1f2e'); sky.addColorStop(1, '#1e2333');
  hCtx.fillStyle = sky; hCtx.fillRect(0, 0, W, H);
  const glow = hCtx.createRadialGradient(W*0.75, H*0.35, 0, W*0.75, H*0.35, W*0.45);
  glow.addColorStop(0, 'rgba(232,160,32,0.07)'); glow.addColorStop(1, 'transparent');
  hCtx.fillStyle = glow; hCtx.fillRect(0, 0, W, H);
  drops.forEach(d => {
    d.y += d.speed;
    if (d.y > 1.05) { d.y = -0.05; d.x = Math.random(); }
    hCtx.beginPath(); hCtx.strokeStyle = `rgba(150,180,220,${d.opacity})`; hCtx.lineWidth = 0.8;
    hCtx.moveTo(d.x*W, d.y*H); hCtx.lineTo(d.x*W-3, (d.y+d.length)*H); hCtx.stroke();
  });
  particles.forEach(p => {
    p.x += p.vx; p.y += p.vy;
    if (p.y < -0.02) { p.y = 1; p.x = Math.random(); }
    if (p.x < 0 || p.x > 1) p.vx *= -1;
    hCtx.beginPath(); hCtx.arc(p.x*W, p.y*H, p.r, 0, Math.PI*2);
    hCtx.fillStyle = `rgba(232,160,32,${p.opacity})`; hCtx.fill();
  });
  roofShapes.forEach((s, i) => {
    const bx = s.x*W, topY = (1-s.h)*H, botY = s.y*H, bw = s.w*W, peakX = bx+s.peak*bw;
    hCtx.shadowColor = 'rgba(0,0,0,0.6)'; hCtx.shadowBlur = 30;
    hCtx.beginPath(); hCtx.moveTo(bx, botY); hCtx.lineTo(bx, topY+bw*0.18);
    hCtx.lineTo(peakX, topY); hCtx.lineTo(bx+bw, topY+bw*0.18); hCtx.lineTo(bx+bw, botY); hCtx.closePath();
    const grad = hCtx.createLinearGradient(bx, topY, bx+bw, botY);
    grad.addColorStop(0, `rgba(${15+i*4},${20+i*3},${32+i*5},0.95)`); grad.addColorStop(1, `rgba(8,10,18,0.98)`);
    hCtx.fillStyle = grad; hCtx.fill();
    hCtx.shadowBlur = 0;
    hCtx.beginPath(); hCtx.moveTo(bx, topY+bw*0.18); hCtx.lineTo(peakX, topY); hCtx.lineTo(bx+bw, topY+bw*0.18);
    hCtx.strokeStyle = `rgba(232,160,32,${0.12+Math.sin(heroT*0.5+i)*0.06})`; hCtx.lineWidth = 1.5; hCtx.stroke();
    const winY = botY - bw*0.28;
    [0.2, 0.55].forEach(wx => {
      const winX = bx+wx*bw, ww = bw*0.12, wh = bw*0.14;
      hCtx.fillStyle = `rgba(232,160,32,${0.06+Math.sin(heroT*0.8+i+wx)*0.03})`; hCtx.fillRect(winX, winY, ww, wh);
      hCtx.strokeStyle = 'rgba(232,160,32,0.15)'; hCtx.lineWidth = 0.5; hCtx.strokeRect(winX, winY, ww, wh);
    });
  });
  const horizon = hCtx.createLinearGradient(0, H*0.72, 0, H);
  horizon.addColorStop(0, 'rgba(192,57,43,0.08)'); horizon.addColorStop(1, 'rgba(192,57,43,0.02)');
  hCtx.fillStyle = horizon; hCtx.fillRect(0, H*0.72, W, H*0.28);
  heroT += 0.016;
  requestAnimationFrame(drawHero);
}
drawHero();

const houseCanvas = document.getElementById('houseCanvas');
const hC = houseCanvas.getContext('2d');

function resizeHouse() { houseCanvas.width = houseCanvas.offsetWidth; houseCanvas.height = houseCanvas.offsetHeight; }
resizeHouse();
window.addEventListener('resize', resizeHouse);

let houseAngle = 0.3;

function project(x, y, z, W, H, angle) {
  const cos = Math.cos(angle), sin = Math.sin(angle);
  const rx = x*cos - z*sin, rz = x*sin + z*cos;
  const perspective = 600 / (600 + rz + 200);
  return { sx: W/2 + rx*perspective*80, sy: H/2 + (y-0.5)*perspective*80 - 30, depth: rz };
}

function drawFace(pts, fillStyle, strokeStyle = null) {
  if (pts.length < 3) return;
  hC.beginPath(); hC.moveTo(pts[0].sx, pts[0].sy);
  for (let i = 1; i < pts.length; i++) hC.lineTo(pts[i].sx, pts[i].sy);
  hC.closePath(); hC.fillStyle = fillStyle; hC.fill();
  if (strokeStyle) { hC.strokeStyle = strokeStyle; hC.lineWidth = 1; hC.stroke(); }
}

function drawHouse3D(t) {
  const W = houseCanvas.width, H = houseCanvas.height;
  hC.clearRect(0, 0, W, H);
  hC.fillStyle = '#151821'; hC.fillRect(0, 0, W, H);
  hC.strokeStyle = 'rgba(255,255,255,0.03)'; hC.lineWidth = 1;
  for (let i = 0; i < W; i += 40) { hC.beginPath(); hC.moveTo(i,0); hC.lineTo(i,H); hC.stroke(); }
  for (let i = 0; i < H; i += 40) { hC.beginPath(); hC.moveTo(0,i); hC.lineTo(W,i); hC.stroke(); }
  const angle = houseAngle;
  const p = (x, y, z) => project(x, y, z, W, H, angle);
  const hw = 1.4, hh = 1.0, hd = 1.0, by = 0.4;
  const v = {
    fbl: p(-hw,by,-hd), fbr: p(hw,by,-hd), ftr: p(hw,by-hh,-hd), ftl: p(-hw,by-hh,-hd),
    bbl: p(-hw,by,hd), bbr: p(hw,by,hd), btr: p(hw,by-hh,hd), btl: p(-hw,by-hh,hd),
    frontPeakL: p(-hw,by-hh-0.9,-hd), frontPeakR: p(hw,by-hh-0.9,-hd),
    backPeakL: p(-hw,by-hh-0.9,hd), backPeakR: p(hw,by-hh-0.9,hd),
    ridgeL: p(-hw-0.2,by-hh-0.6,0), ridgeR: p(hw+0.2,by-hh-0.6,0),
  };
  hC.beginPath(); hC.ellipse(W/2, H*0.78, W*0.28, H*0.04, 0, 0, Math.PI*2);
  hC.fillStyle = 'rgba(0,0,0,0.4)'; hC.fill();
  drawFace([v.fbl,v.fbr,v.ftr,v.ftl], '#1c2235', 'rgba(255,255,255,0.08)');
  drawFace([v.fbr,v.bbr,v.btr,v.ftr], '#14191f', 'rgba(255,255,255,0.05)');
  drawFace([v.ftl,v.ftr,v.frontPeakR,v.frontPeakL], '#232a3a', 'rgba(255,255,255,0.1)');
  drawFace([v.btl,v.btr,v.backPeakR,v.backPeakL], '#10141c', 'rgba(0,0,0,0.2)');
  drawFace([v.frontPeakL,v.frontPeakR,v.ridgeR,v.ridgeL], '#c0392b', 'rgba(255,255,255,0.15)');
  drawFace([v.ridgeL,v.ridgeR,v.backPeakR,v.backPeakL], '#922b21', 'rgba(0,0,0,0.3)');
  hC.beginPath(); hC.moveTo(v.ridgeL.sx,v.ridgeL.sy); hC.lineTo(v.ridgeR.sx,v.ridgeR.sy);
  hC.strokeStyle = 'rgba(232,160,32,0.6)'; hC.lineWidth = 2.5; hC.stroke();
  const dl=p(-0.28,by,-hd-0.01), dr=p(0.28,by,-hd-0.01), dtl=p(-0.28,by-0.55,-hd-0.01), dtr=p(0.28,by-0.55,-hd-0.01);
  drawFace([dl,dr,dtr,dtl], 'rgba(232,160,32,0.15)', 'rgba(232,160,32,0.4)');
  [[-1.0],[0.75]].forEach(([wx]) => {
    const wl=p(wx-0.22,by-0.25,-hd-0.01), wr=p(wx+0.22,by-0.25,-hd-0.01);
    const wtl=p(wx-0.22,by-0.7,-hd-0.01), wtr=p(wx+0.22,by-0.7,-hd-0.01);
    drawFace([wl,wr,wtr,wtl], `rgba(232,160,32,${0.08+Math.sin(t*1.2+wx)*0.04})`, 'rgba(232,160,32,0.35)');
  });
  const cx=p(0.7,by-hh-1.3,-0.3), cxr=p(0.95,by-hh-1.3,-0.3), cxb=p(0.7,by-hh-0.55,-0.3), cxbr=p(0.95,by-hh-0.55,-0.3);
  drawFace([cxb,cxbr,cxr,cx], '#1a1f2e', 'rgba(232,160,32,0.2)');
  for (let i = 0; i < 4; i++) {
    const smokeT = (t*0.5 + i*0.7) % 1;
    const sx2 = cx.sx + (cxr.sx-cx.sx)*0.5, sy2 = cx.sy - smokeT*40;
    hC.beginPath(); hC.arc(sx2, sy2, smokeT*12+2, 0, Math.PI*2);
    hC.fillStyle = `rgba(200,210,220,${(1-smokeT)*0.25})`; hC.fill();
  }
  const roofCx=(v.ridgeL.sx+v.ridgeR.sx)/2, roofCy=(v.ridgeL.sy+v.ridgeR.sy)/2;
  const rg = hC.createRadialGradient(roofCx,roofCy,0,roofCx,roofCy,100);
  rg.addColorStop(0, `rgba(232,160,32,${0.06+Math.sin(t)*0.02})`); rg.addColorStop(1,'transparent');
  hC.fillStyle = rg; hC.fillRect(0, 0, W, H);
}

let houseT = 0;
function animateHouse() {
  houseAngle += 0.005; houseT += 0.02;
  drawHouse3D(houseT);
  requestAnimationFrame(animateHouse);
}
animateHouse();

const revealEls = document.querySelectorAll('.reveal');
const observer = new IntersectionObserver((entries) => {
  entries.forEach((e, i) => { if (e.isIntersecting) setTimeout(() => e.target.classList.add('visible'), i*80); });
}, { threshold: 0.1 });
revealEls.forEach(el => observer.observe(el));

function handleSubmit() {
  const btn = document.querySelector('.submit-btn');
  btn.textContent = '✓ Request Sent!'; btn.style.background = '#27ae60'; btn.style.color = 'white';
  setTimeout(() => { btn.textContent = 'Send Request →'; btn.style.background = ''; btn.style.color = ''; }, 3000);
}
</script>
