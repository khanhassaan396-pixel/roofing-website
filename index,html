<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Full Roofing & Leak Repair Pros | Bayonne, NJ</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&family=Playfair+Display:ital@1&display=swap" rel="stylesheet">
<style>
  :root {
    --steel: #1a1f2e;
    --rust: #c0392b;
    --amber: #e8a020;
    --slate: #2d3748;
    --fog: #8899aa;
    --cream: #f5f0e8;
    --white: #ffffff;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--steel);
    color: var(--cream);
    font-family: 'DM Sans', sans-serif;
    overflow-x: hidden;
    cursor: none;
  }

  /* Custom Cursor */
  .cursor {
    position: fixed;
    width: 12px; height: 12px;
    background: var(--amber);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s, width 0.2s, height 0.2s;
    mix-blend-mode: screen;
  }
  .cursor-ring {
    position: fixed;
    width: 36px; height: 36px;
    border: 1px solid rgba(232,160,32,0.5);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease-out, width 0.3s, height 0.3s;
  }
  body:hover .cursor-ring { opacity: 1; }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4rem 3rem;
    background: linear-gradient(to bottom, rgba(26,31,46,0.95) 0%, transparent 100%);
    backdrop-filter: blur(4px);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.15em;
    color: var(--amber);
  }
  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }
  .nav-links a {
    color: var(--fog);
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--amber); }
  .nav-cta {
    background: var(--rust);
    color: white;
    padding: 0.6rem 1.4rem;
    text-decoration: none;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    transition: background 0.2s, transform 0.2s;
  }
  .nav-cta:hover { background: #e04030; transform: translateY(-1px); }

  /* HERO */
  #hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  canvas#roofCanvas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: 0;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: 0 5vw;
    max-width: 750px;
  }

  .hero-tag {
    display: inline-block;
    background: var(--rust);
    color: white;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0.35rem 0.9rem;
    margin-bottom: 1.5rem;
    animation: slideIn 0.8s 0.2s both;
  }

  .hero-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.9;
    letter-spacing: 0.02em;
    color: var(--white);
    animation: slideIn 0.8s 0.4s both;
  }
  .hero-title span { color: var(--amber); }

  .hero-sub {
    margin-top: 1.8rem;
    font-size: 1.05rem;
    color: var(--fog);
    line-height: 1.7;
    max-width: 480px;
    animation: slideIn 0.8s 0.6s both;
  }

  .hero-actions {
    margin-top: 2.5rem;
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
    animation: slideIn 0.8s 0.8s both;
  }

  .btn-primary {
    background: var(--amber);
    color: var(--steel);
    padding: 0.9rem 2.2rem;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    display: inline-block;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(232,160,32,0.35);
  }

  .btn-outline {
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    padding: 0.9rem 2.2rem;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
    display: inline-block;
  }
  .btn-outline:hover {
    border-color: var(--amber);
    background: rgba(232,160,32,0.08);
  }

  .hero-badge {
    position: absolute;
    right: 8vw;
    bottom: 12vh;
    z-index: 2;
    text-align: center;
    animation: float 4s ease-in-out infinite;
  }
  .badge-ring {
    width: 120px; height: 120px;
    border-radius: 50%;
    border: 1px solid rgba(232,160,32,0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(26,31,46,0.8);
    backdrop-filter: blur(8px);
  }
  .badge-stars { color: var(--amber); font-size: 0.8rem; letter-spacing: 2px; }
  .badge-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.8rem;
    line-height: 1;
    color: white;
  }
  .badge-label { font-size: 0.62rem; color: var(--fog); letter-spacing: 0.1em; text-transform: uppercase; }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--fog);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: bounce 2s infinite;
  }
  .scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--amber), transparent);
  }

  /* STATS BAR */
  .stats-bar {
    background: var(--rust);
    padding: 1.4rem 5vw;
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .stat-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    animation: fadeUp 0.6s both;
  }
  .stat-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.4rem;
    color: white;
    line-height: 1;
  }
  .stat-label {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.7);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1.4;
    max-width: 80px;
  }

  /* SERVICES */
  #services {
    padding: 8rem 5vw;
    position: relative;
  }

  .section-label {
    font-size: 0.72rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 1rem;
  }

  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: white;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .section-sub {
    color: var(--fog);
    font-size: 0.95rem;
    max-width: 400px;
    line-height: 1.7;
    margin-bottom: 4rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.06);
  }

  .service-card {
    background: var(--steel);
    padding: 2.5rem;
    transition: background 0.3s;
    position: relative;
    overflow: hidden;
  }
  .service-card::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 3px;
    background: var(--amber);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s;
  }
  .service-card:hover { background: var(--slate); }
  .service-card:hover::before { transform: scaleX(1); }

  .service-icon {
    font-size: 2.5rem;
    margin-bottom: 1.2rem;
    display: block;
  }

  .service-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    color: white;
    letter-spacing: 0.05em;
    margin-bottom: 0.8rem;
  }

  .service-desc {
    color: var(--fog);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  /* 3D ROOF SHOWCASE */
  #showcase {
    padding: 6rem 5vw;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5vw;
    align-items: center;
    background: #151821;
  }

  .showcase-visual {
    position: relative;
    height: 420px;
  }

  canvas#houseCanvas {
    width: 100%;
    height: 100%;
    border: 1px solid rgba(255,255,255,0.06);
  }

  .showcase-list {
    list-style: none;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .showcase-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--fog);
    font-size: 0.9rem;
  }

  .check {
    width: 22px; height: 22px;
    background: rgba(232,160,32,0.15);
    border: 1px solid var(--amber);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    color: var(--amber);
    flex-shrink: 0;
  }

  /* REVIEWS */
  #reviews {
    padding: 8rem 5vw;
    background: var(--steel);
  }

  .reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .big-rating {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 5rem;
    color: var(--amber);
    line-height: 1;
  }

  .stars-row {
    color: var(--amber);
    font-size: 1.2rem;
    letter-spacing: 3px;
  }

  .rating-sub {
    color: var(--fog);
    font-size: 0.8rem;
    margin-top: 0.3rem;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .review-card {
    background: var(--slate);
    padding: 2rem;
    border-left: 3px solid var(--amber);
    transition: transform 0.3s;
  }
  .review-card:hover { transform: translateY(-4px); }

  .review-quote {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 1.05rem;
    color: var(--cream);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .reviewer-info {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .reviewer-avatar {
    width: 38px; height: 38px;
    border-radius: 50%;
    background: var(--rust);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    color: white;
  }

  .reviewer-name {
    font-size: 0.88rem;
    font-weight: 500;
    color: white;
  }
  .reviewer-date { font-size: 0.75rem; color: var(--fog); }
  .review-stars { color: var(--amber); font-size: 0.8rem; margin-top: 0.2rem; }

  /* CONTACT */
  #contact {
    padding: 8rem 5vw;
    background: #151821;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6vw;
    align-items: start;
  }

  .contact-detail {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-icon {
    font-size: 1.3rem;
    color: var(--amber);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .contact-text {
    color: var(--fog);
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .contact-text strong { color: white; display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.2rem; }

  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(39,174,96,0.15);
    border: 1px solid rgba(39,174,96,0.4);
    color: #2ecc71;
    padding: 0.4rem 0.9rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 0.5rem;
  }
  .open-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #2ecc71;
    animation: pulse 2s infinite;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fog);
  }

  .form-group input,
  .form-group textarea,
  .form-group select {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    color: white;
    padding: 0.9rem 1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    transition: border-color 0.2s;
    outline: none;
    width: 100%;
  }
  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus { border-color: var(--amber); }
  .form-group textarea { height: 100px; resize: none; }
  .form-group select option { background: var(--slate); }

  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

  .submit-btn {
    background: var(--amber);
    color: var(--steel);
    padding: 1rem;
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    margin-top: 0.5rem;
  }
  .submit-btn:hover { background: #f0b030; transform: translateY(-2px); }

  /* FOOTER */
  footer {
    background: #0e1118;
    padding: 2rem 5vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .footer-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem;
    color: var(--amber);
    letter-spacing: 0.1em;
  }
  .footer-copy { color: var(--fog); font-size: 0.78rem; }
  .footer-phone { color: var(--amber); font-size: 0.88rem; text-decoration: none; }
  .footer-phone:hover { color: white; }

  /* ANIMATIONS */
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s, transform 0.7s;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    #showcase, #contact { grid-template-columns: 1fr; }
    .hero-badge { display: none; }
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
    .showcase-visual { height: 300px; }
  }
</style>
</head>
